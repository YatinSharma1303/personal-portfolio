# ============================================================================
#  COPY this file to ".env" and fill in your real values.
#  ".env" is gitignored, so these NEVER get pushed to GitHub.
#  On Vercel, add these same names under Project → Settings → Environment Variables.
#
#  NOTE: Anything starting with VITE_ is bundled into the public site and IS
#  visible to visitors in the browser. That is normal for frontend keys.
#  Real protection comes from Firestore Security Rules (see firestore.rules).
# ============================================================================

# --- Firebase (from Firebase Console → Project Settings → Your apps → Web) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Admin (the Google account allowed to answer AMA questions) ---
VITE_ADMIN_EMAIL=yatinsharma1303@gmail.com

# --- Last.fm (free key: https://www.last.fm/api/account/create) ---
VITE_LASTFM_API_KEY=

# --- Optional: only if AMA mode = "formspree" instead of "full" ---
VITE_FORMSPREE_ENDPOINT=
