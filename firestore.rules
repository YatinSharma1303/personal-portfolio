rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "yatinsharma1303@gmail.com";
    }

    match /amaQuestions/{questionId} {
      allow read: if isAdmin() || resource.data.answered == true;

      allow create: if request.resource.data.keys().hasOnly([
          "id", "name", "question", "answer", "answered", "createdAt", "answeredAt", "votes"
        ])
        && request.resource.data.id is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 280
        && request.resource.data.answer == ""
        && request.resource.data.answered == false
        && request.resource.data.answeredAt == null
        && request.resource.data.votes is int
        && request.resource.data.votes == 0;

      // Only admin can update/delete directly. Reactions + votes are handled
      // server-side by the service account (bypasses these rules entirely).
      allow update, delete: if isAdmin();
    }

    match /telegramEditSessions/{id} {
      allow read, write: if false;
    }

    match /siteStats/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
