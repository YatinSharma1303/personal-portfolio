rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ask Me Anything questions
    match /amaQuestions/{id} {

      // Anyone may read ONLY questions that have been answered.
      allow read: if resource.data.answered == true
                  // ...and the admin can read everything (to manage the inbox).
                  || (request.auth != null
                      && request.auth.token.email_verified == true
                      && request.auth.token.email == "yatinsharma1303@gmail.com");

      // Anyone may CREATE a question, with strict shape + size limits,
      // and it must start as un-answered with an empty answer.
      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'question', 'answer', 'answered', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.question is string
                    && request.resource.data.question.size() > 0
                    && request.resource.data.question.size() <= 280
                    && request.resource.data.answer == ""
                    && request.resource.data.answered == false;

      // Only the verified admin may answer (update) or delete.
      allow update, delete: if request.auth != null
                            && request.auth.token.email_verified == true
                            && request.auth.token.email == "yatinsharma1303@gmail.com";
    }

    // Lock everything else down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
